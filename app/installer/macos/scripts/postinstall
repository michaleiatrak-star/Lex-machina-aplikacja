#!/bin/bash
# The package copies code; preparation/downloads run as the user in the app's own window.
# A headless installation remains valid and prepares components on the user's first launch.
set -eu
APP="${2:-/}/Applications/Lex Machina.app"
[ -d "$APP" ] || APP="/Applications/Lex Machina.app"
console_user="$(/usr/bin/stat -f%Su /dev/console)"
if [ -n "$console_user" ] && [ "$console_user" != root ] && [ "$console_user" != _mbsetupuser ] && [ "$console_user" != loginwindow ]; then
  console_uid="$(/usr/bin/id -u "$console_user")"
  /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open -a "$APP" || \
    echo "Otwórz Lex Machina z folderu Programy, aby dokończyć przygotowanie."
fi
echo "Lex Machina została zainstalowana. Przygotowanie pozostałych narzędzi będzie widoczne w aplikacji."
exit 0
